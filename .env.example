PORT=8080
DATABASE_URL=postgresql://neondb_owner:password@ep-something.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://neondb_owner:password@ep-something-pooler.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
ADMIN_EMAIL=you@example.com
# Generate with: go run ./cmd/hashpw "your-password"   (keep single quotes here, bcrypt hashes contain $)
ADMIN_PASSWORD_HASH='$2a$10$replace.me'
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,https://qibeekay.vercel.app
MAX_UPLOAD_MB=5

# Cloudinary image upload configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=portfolio
